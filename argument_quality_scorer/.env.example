# ArgumentQualityScorer 配置文件
# 复制此文件为 .env 并填写你的配置

# LLM 配置（可选，不配置则使用纯规则/词典法）
# 支持任何 OpenAI-compatible API（如 GLM-4-Flash、Perplexity 等）
LLM_API_BASE=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=your-api-key-here
LLM_MODEL=glm-4-flash

# 或使用 OpenAI
# LLM_API_BASE=https://api.openai.com/v1
# LLM_API_KEY=sk-xxx
# LLM_MODEL=gpt-4o-mini

# 评分权重配置（可选，使用默认值）
# WEIGHT_LOGIC=0.35
# WEIGHT_EVIDENCE=0.35
# WEIGHT_EMOTION=0.30

# 启用 Baidu Senta（可选，需要安装 paddlepaddle）
# USE_SENTA=false

# 调试模式
# DEBUG=false
